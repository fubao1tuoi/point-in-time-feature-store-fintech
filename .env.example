# Copy file này thành .env và chỉ điền giá trị local.
# Không commit .env hoặc Kaggle credential.

PROJECT_ENV=development
DATA_ROOT=data
RAW_DATA_DIR=data/raw
BRONZE_DATA_DIR=data/bronze
SILVER_DATA_DIR=data/silver
OFFLINE_STORE_DIR=data/offline_store
REPORTS_DIR=reports/generated
SYNTHETIC_EPOCH=2017-01-01T00:00:00Z

# Google Cloud deployment — non-secret identifiers only.
# Copy the commands from docs/GCP_WEEK3_1_CLOUD_CONFIGURATION.md into PowerShell.
GCP_PROJECT_ID=replace-with-your-gcp-project-id
GCP_REGION=asia-southeast1
GCP_DATA_BUCKET=replace-with-a-globally-unique-private-bucket-name
PIT_DATA_ROOT=/mnt/pit-data

